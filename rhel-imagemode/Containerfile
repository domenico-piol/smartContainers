FROM registry.redhat.io/rhel10/rhel-bootc:latest

RUN dnf -y install \
    openssh-server \
    && dnf clean all

# Step 3: Configure the system or application
RUN systemctl enable sshd

# Step 4: Create a default domenico user and inject an SSH public key
# (Replace the placeholder public key with your actual SSH key)
RUN useradd -m -G wheel domenico && \
    echo "domenico ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/domenico && \
    mkdir -m 0700 -p /home/domenico/.ssh && \
    echo "ssh-rsa  domenico@dpiol1-mac" > /home/domenico/.ssh/authorized_keys && \
    chown -R domenico:domenico /home/domenico/.ssh && \
    chmod 0600 /home/domenico/.ssh/authorized_keys
